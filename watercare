<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>H2O Care - Giải pháp uống nước toàn diện</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            margin: 0;
            padding: 0;
            background-color: #b2ebf2; /* Màu nền xanh ngọc */
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .app-container {
            width: 400px;
            background: white;
            border-radius: 30px;
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
            overflow: hidden;
            position: relative;
        }
        
        /* Menu chuyển giao diện */
        .nav-tabs {
            display: flex;
            flex-wrap: wrap;
            background: #00bcd4;
            padding: 10px;
        }
        .nav-tabs button {
            flex: 1 1 45%;
            margin: 2px;
            padding: 10px;
            border: none;
            border-radius: 10px;
            background: rgba(255,255,255,0.2);
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            font-size: 0.85em;
        }
        .nav-tabs button.active {
            background: white;
            color: #00bcd4;
        }

        /* Khung hiển thị giao diện */
        .view {
            display: none;
            padding: 20px;
            height: 600px; /* Cố định chiều cao app */
            overflow-y: auto;
        }
        .view.active {
            display: block;
        }

        /* 1. Giao diện TRẺ EM */
        #kids-view {
            background: linear-gradient(180deg, #4fc3f7 0%, #0288d1 100%);
            color: white;
            text-align: center;
        }
        #kids-view h2 { font-size: 1.5em; text-shadow: 1px 1px 2px #000; }
        .turtle-pet { font-size: 80px; margin: 20px 0; }
        .glass-box {
            background: rgba(255,255,255,0.8);
            color: #333;
            padding: 20px;
            border-radius: 20px;
            margin-top: 30px;
            font-size: 1.2em;
            font-weight: bold;
        }
        .btn-drink-kids {
            background: #ffeb3b;
            color: #d84315;
            border: none;
            padding: 15px 30px;
            border-radius: 30px;
            font-size: 1.2em;
            font-weight: bold;
            margin-top: 20px;
            cursor: pointer;
            box-shadow: 0 4px #fbc02d;
        }

        /* 2. Giao diện THANH THIẾU NIÊN */
        #teens-view {
            background: linear-gradient(180deg, #dcedc8 0%, #8bc34a 100%);
            text-align: center;
        }
        .streak-tree { font-size: 60px; margin: 10px 0; }.streak-number {
            font-size: 3em;
            font-weight: bold;
            color: #33691e;
            margin: 0;
        }
        .team-list {
            background: white;
            border-radius: 15px;
            padding: 15px;
            margin-top: 20px;
            text-align: left;
        }
        .team-member {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }
        .btn-checkin {
            background: #4caf50;
            color: white;
            border: none;
            padding: 15px;
            width: 100%;
            border-radius: 15px;
            font-size: 1.2em;
            font-weight: bold;
            margin-top: 20px;
            cursor: pointer;
        }

        /* 3. Giao diện DÂN VĂN PHÒNG */
        #office-view {
            background: #fdfbfb;
            color: #263238;
        }
        .progress-circle {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: conic-gradient(#4dd0e1 60%, #e0f7fa 0);
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 20px auto;
        }
        .inner-circle {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .inner-circle h2 { margin: 0; font-size: 2.5em; color: #00838f; }
        .inner-circle p { margin: 5px 0 0 0; color: #546e7a; font-size: 0.9em;}
        .quick-add { display: flex; gap: 15px; margin-top: 20px; }
        .quick-btn {
            flex: 1;
            padding: 15px;
            background: white;
            border: 2px solid #b2ebf2;
            border-radius: 15px;
            font-weight: bold;
            color: #00838f;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .leaderboard {
            background: white;
            padding: 15px;
            border-radius: 15px;
            margin-top: 20px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        /* 4. Giao diện NGƯỜI CAO TUỔI */
        #elderly-view {
            background: white;
            color: #000;
        }
        .elderly-header {
            font-size: 1.6em;
            font-weight: bold;
            color: #1565c0;
            border-bottom: 2px solid #bbdefb;
            padding-bottom: 10px;
        }
        .elderly-progress {
            border: 4px solid #64b5f6;
            border-radius: 50%;
            width: 220px;
            height: 220px;
            margin: 30px auto;
            display: flex;
            flex-direction: column;
            justify-content: center;align-items: center;
        }
        .elderly-progress h2 { font-size: 2.2em; margin: 10px 0; color: #0d47a1; }
        .schedule { margin-top: 30px; }
        .time-slot {
            display: flex;
            justify-content: space-between;
            padding: 15px;
            background: #f1f8e9;
            margin-bottom: 10px;
            border-radius: 10px;
            font-size: 1.2em;
            align-items: center;
        }
        .time-slot.done { background: #e8f5e9; color: #2e7d32; }
        .time-slot.now { background: #bbdefb; border: 2px solid #1976d2; font-weight: bold;}

    </style>
</head>
