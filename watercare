            <div class="leaderboard">
                <h4 style="margin-top: 0; text-align: center;">BẢNG XẾP HẠNG ĐỘI NHÓM</h4>
                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                    <strong>1. ĐỘI IT</strong> <span style="color: #f57c00;">95%</span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <strong>2. ĐỘI SALES</strong> <span style="color: #fbc02d;">85%</span>
                </div>
            </div>
